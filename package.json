{
  "name": "ecommerce-nextjs",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme e-commerce full-stack TypeScript (Next.js App Router + Prisma + PostgreSQL)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "db:ajouter-produits": "tsx prisma/ajouter-produits.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "2.4.3",
    "framer-motion": "^11.11.17",
    "jose": "5.9.6",
    "next": "14.2.18",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "swiper": "^11.1.14",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  }
}
